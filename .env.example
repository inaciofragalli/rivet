# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rivet
DB_USERNAME=rivet
DB_PASSWORD=replace_me

# Rivet
RIVET_IMAGE_STORAGE_DIR=./data/images
RIVET_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Initial administrator
RIVET_BOOTSTRAP_EMAIL=admin@example.com
RIVET_BOOTSTRAP_PASSWORD=replace_me

# Local HTTP only; use true em produção com HTTPS
RIVET_SESSION_COOKIE_SECURE=false